  },
  "item": [
    {
      "name": "1. Pet",
      "item": [
        {
          "name": "Add a new pet",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate unique test data per run",
                  "const id = Math.floor(100000 + Math.random() * 900000) + 9000000;",
                  "pm.collectionVariables.set(\"petId\", id);",
                  "const names = [\"Buddy\",\"Max\",\"Luna\",\"Charlie\",\"Bella\",\"Rocky\",\"Daisy\",\"Milo\"];",
                  "pm.collectionVariables.set(\"petName\", names[Math.floor(Math.random()*names.length)] + \"_\" + id);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const json = pm.response.json();",
                  "pm.test(\"Pet created with correct data\", () => {",
                  "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get(\"petId\")));",
                  "    pm.expect(json.name).to.eql(pm.collectionVariables.get(\"petName\"));",
                  "    pm.expect(json.status).to.eql(\"available\");",
                  "    pm.expect(json.tags).to.be.an(\"array\").with.lengthOf(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pet"
              ]
            },
            "description": "Creates a pet with a generated unique ID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{petId}},\n  \"category\": {\n    \"id\": 1,\n    \"name\": \"Dogs\"\n  },\n  \"name\": \"{{petName}}\",\n  \"photoUrls\": [\n    \"https://example.com/photos/buddy1.jpg\"\n  ],\n  \"tags\": [\n    {\n      \"id\": 101,\n      \"name\": \"friendly\"\n    },\n    {\n      \"id\": 102,\n      \"name\": \"vaccinated\"\n    }\n  ],\n  \"status\": \"available\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Find pet by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response time < 3000ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "const json = pm.response.json();",
                  "pm.test(\"Correct pet returned\", () => {",
                  "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get(\"petId\")));",
                  "    pm.expect(json).to.have.all.keys(\"id\",\"category\",\"name\",\"photoUrls\",\"tags\",\"status\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
